# Copie para .env e preencha. O .env NAO vai para o Git.

# Client IDs OAuth do Google (web, Android, iOS), separados por virgula.
GOOGLE_CLIENT_IDS=seu_client_id_web.apps.googleusercontent.com

# Mesmo valor no Backend. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=

# Chave do script de fabrica (rotas /admin)
ADMIN_API_KEY=

# Como os eventos chegam ao Backend:
#   direto   = a API chama o Backend na hora (sem RabbitMQ e sem worker)
#   rabbitmq = fila + worker (docker-compose ja liga este modo)
EVENTOS_MODO=direto

# Chave para atualizar o Backend (mesmo valor no Backend). Usada pela API
# no modo direto e pelo worker no modo rabbitmq.
SERVICO_API_KEY=

# Onde encontrar o Backend (API no modo direto, worker no modo rabbitmq)
BACKEND_URL=http://host.docker.internal:8001

# Regra de negocio: torres por usuario
MAX_TORRES_POR_USUARIO=1

# true libera POST /auth/dev (login sem Google). Nunca em producao.
AUTH_MODO_DEV=false

# Origens permitidas (app e loja). Vazio = todas (so desenvolvimento).
CORS_ORIGENS=
