# Copie para .env e preencha. O .env NAO vai para o Git.

# Client IDs OAuth do Google (web, Android, iOS), separados por virgula.
GOOGLE_CLIENT_IDS=seu_client_id_web.apps.googleusercontent.com

# Mesmo valor no Backend. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=

# Chave do script de fabrica (rotas /admin)
ADMIN_API_KEY=

# Chave que o worker usa para atualizar o Backend (mesmo valor no Backend)
SERVICO_API_KEY=

# Onde o worker encontra o Backend
BACKEND_URL=http://host.docker.internal:8001

# Regra de negocio: torres por usuario
MAX_TORRES_POR_USUARIO=1

# true libera POST /auth/dev (login sem Google). Nunca em producao.
AUTH_MODO_DEV=false

# Origens permitidas (app e loja). Vazio = todas (so desenvolvimento).
CORS_ORIGENS=
